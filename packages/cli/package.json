{
  "name": "@caiquebrito/nodum-cli",
  "version": "2.2.1",
  "description": "CLI interface for nodum",
  "type": "module",
  "bin": {
    "nodum": "./dist/bin/nodum.js"
  },
  "main": "./dist/index.js",
