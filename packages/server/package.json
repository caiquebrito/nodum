{
  "name": "@caiquebrito/nodum-server",
  "version": "2.0.1",
  "description": "HTTP server and visualizer backend for nodum",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": ["dist", "viewer"],
  "scripts": {
    "build": "tsc && rm -rf viewer && cp -R ../viewer viewer",
    "dev": "tsc --watch",
    "test": "vitest",
    "clean": "rm -rf dist viewer"
  },
  "dependencies": {
    "@caiquebrito/nodum-core": "^2.0.0",
    "express": "^4.18.0",
    "open": "^9.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
