{
  "name": "@caiquebrito/nodum-lsp",
  "version": "2.17.0",
  "description": "Language Server Protocol server for nodum — graph queries as workspace/symbol, hover, codeLens, references, and diagnostics in any LSP-speaking IDE",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "bin": {
    "nodum-lsp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "lsp",
    "language-server-protocol",
    "code-analysis",
    "knowledge-graph"
  ],
  "author": "Caique Brito",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/caiquebrito/nodum"
  },
  "dependencies": {
    "@caiquebrito/nodum-core": "^2.17.1",
    "@caiquebrito/nodum-query": "^2.17.0",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
